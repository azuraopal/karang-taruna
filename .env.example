# Konfigurasi Lingkungan (Environment Variables) Karang Taruna Margabakti 07

# Port aplikasi
PORT=3000

# Mode runtime (development / production)
NODE_ENV=production

# URL Koneksi PostgreSQL
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://katar_user:katar_secure_pass_2026@localhost:5432/karang_taruna_margabakti

# Pengaturan SSL PostgreSQL jika menggunakan cloud database eksternal (Supabase/Neon/Aiven)
PGSSLMODE=disable
